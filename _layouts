
---
layout: default
---

<article class="post">

  <header class="post-header">
    <h1>{{ page.title }}</h1>

    <p class="post-meta">
      {{ page.date | date: "%d-%m-%Y" }}
      | {{ page.author }}
    </p>
  </header>

  {% if page.image %}
  <img
    src="{{ page.image | relative_url }}"
    alt="{{ page.title | escape }}"
    class="post-image">
  {% endif %}

  <div class="post-content">
    {{ content }}
  </div>

  {% unless page.hide_buttons %}
  <div class="post-buttons">
    <!-- Tombol opsional -->
  </div>
  {% endunless %}

</article>
